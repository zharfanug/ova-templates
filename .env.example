# Copy to .env and edit. .env is gitignored.
# Every value is optional; empty values fall back to the defaults shown.

# --- Branding (shown when importing the OVA) ------------------------------
# Product name. {os}, {ver}, {role} are replaced per template,
# e.g. "Debian 13 Docker Template".
PRODUCT_NAME="{os} {ver} {role} Template"
# Version string (default: build ID).
PRODUCT_VERSION=""
PRODUCT_URL=""
VENDOR=""
VENDOR_URL=""

# --- Output file name -----------------------------------------------------
# Optional prefix:
#   <prefix>-<os>-<ver>[-<role>]-<arch>-efi-<platform>.ova  (no prefix if empty)
OVA_PREFIX=""

# --- Defaults baked into the image (the deployer can override them) -------
DEFAULT_DOMAIN="example.com"
DEFAULT_USERNAME="admin"
