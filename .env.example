# Copy to .env and edit. .env is gitignored.
# Every value is optional. A commented-out (unset) variable uses the
# default shown; set it to "" to leave the field out.
# The same names also work as environment variables (they win over .env).

# --- Product information (shown when importing the OVA) ------------------
# {os}, {ver}, {role} are replaced per template, e.g.
# "ZN Debian 13 Template", "ZN Debian 13 Docker Template".
#PRODUCT_NAME="ZN {os} {ver} {role} Template"
# {timestamp} = build start, YYYYMMDDhhmm.
#PRODUCT_VERSION="1.0.0.{timestamp}"
#VENDOR="zharfanug"
#PRODUCT_URL="https://github.com/zharfanug/ova-templates"
#VENDOR_URL="https://github.com/zharfanug"

# --- Output file name -----------------------------------------------------
#   <prefix>-<os>-<ver>[-<role>]-<arch>-efi-<platform>.ova
# ("" = no prefix)
#OVA_PREFIX="zn"

# --- Defaults baked into the image (the deployer can override them) -------
#DEFAULT_DOMAIN="example.com"
#DEFAULT_USERNAME="admin"
# Time zone name from the tz database, e.g. "Asia/Jakarta".
#DEFAULT_TIMEZONE="UTC"
