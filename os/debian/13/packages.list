# Debian 13 base: what Debian needs on top of common/packages.list, or
# under Debian-specific names (docs/packages.md, "Debian 13 base").
# Installed without recommends; platform and role packages come from
# their own packages.list.

# Boot
linux-image-amd64
grub-efi-amd64
systemd-sysv

# System
dbus
locales

# Network (ifupdown + DHCP client, like a stock Debian server)
ifupdown
dhcpcd-base
linux-sysctl-defaults # ping_group_range: ping without root

# Hardening (CIS)
apparmor
apparmor-utils
libpam-pwquality
cracklib-runtime    # pwquality dictcheck: dictionary
audispd-plugins
aide-common
python3-systemd     # fail2ban: journal backend
