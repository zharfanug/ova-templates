# Scope: essential watch list. Replaces
# Debian's "/ 0 Full" (whole filesystem). Debian's other snippets still
# apply inside these paths. On trixie /bin and /sbin are symlinks into
# /usr (merged /usr), so the real directories are listed.

# Startup: boot, service units, init scripts, module loading, cron
/boot Full
/etc/systemd Full
/usr/lib/systemd Full
/etc/init\.d Full
/etc/rc\.local$ f Full
/etc/modules-load\.d Full
/etc/modprobe\.d Full
/etc/crontab$ f Full
/etc/cron\.(d|hourly|daily|weekly|monthly) Full
/var/spool/cron Full

# Programs
/usr/bin Full
/usr/sbin Full
# The folder itself without times: "motd --update" (zn-motd) replaces
# /usr/local/bin/motd with a symlink, changing them. Files added, changed or removed in it are still
# reported one by one. Must come before the Full line: for the same path
# AIDE uses the first matching rule.
/usr/local/bin$ d p+i+n+u+g+acl+xattrs+ftype
/usr/local/bin Full
/usr/local/sbin Full

# AIDE configuration and its apt acceptance hook
/etc/aide Full
/etc/default/aide$ f Full
/etc/apt/apt\.conf\.d/99aide-accept$ f Full

# auditd configuration and the audit boot options (journald drop-ins are
# under /etc/systemd)
/etc/audit Full
/etc/default/grub$ f Full

# sudo
/etc/sudoers$ f Full
/etc/sudoers\.d Full

# SSH configuration and keys
/etc/ssh Full
/root/\.ssh Full
/home/[^/]+/\.ssh Full

# User accounts
/etc/(passwd|shadow|group|gshadow)$ f Full

# Login (PAM, pwquality, faillock, limits)
/etc/pam\.d Full
/etc/security Full

# Library preloading (/etc/ld.so.cache is not watched: rebuilt by ldconfig)
/etc/ld\.so\.preload$ f Full
/etc/ld\.so\.conf$ f Full
/etc/ld\.so\.conf\.d Full

# Shell start-up
/etc/profile$ f Full
/etc/profile\.d Full
/etc/bash\.bashrc$ f Full
/etc/environment$ f Full
/root/\.(bashrc|profile|bash_profile|bash_logout)$ f Full
/home/[^/]+/\.(bashrc|profile|bash_profile|bash_logout)$ f Full

# Firewall and fail2ban
/etc/nftables\.conf$ f Full
/etc/nftables\.d Full
/etc/fail2ban Full

# Not watched, though inside the paths above:
# known_hosts only records servers this VM connected to; it changes every
# time someone uses ssh from the VM.
!/root/\.ssh/known_hosts(\.old)?$ f
!/home/[^/]+/\.ssh/known_hosts(\.old)?$ f
# Inhibitor locks apt holds while it runs (released after the apt hook).
!/run/systemd/inhibit(/|$)
# Downloaded packages, deleted by apt after the apt hook ran.
!/var/cache/apt/archives/[^/]+\.deb$ f
# Audit watches on the admin account, rewritten by vapp-seed at boot from
# the account (itself watched); it changes on the second boot (home created)
# and on a vm_username change. With it change audit.rules (+ .prev,
# generated by augenrules from rules.d) and the times of rules.d itself.
# auditd still watches all of them (key audit-config).
!/etc/audit/rules.d/55-admin\.rules$ f
!/etc/audit/audit\.rules(\.prev)?$ f
/etc/audit/rules\.d$ d p+i+n+u+g+acl+xattrs+ftype
# State and log files from Debian's own snippets (31_aide_apt,
# 31_aide_logrotate, 31_aide_aide), outside the essential list: created
# by first-time jobs after the baseline (apt-daily, logrotate, the first
# daily check and its rotations) and then reported every day, because the
# baseline is only replaced after a clean check.
!/var/lib/apt/daily_lock$ f
!/var/lib/logrotate/status$ f
!/var/log/aide/aide\.log(\.[0-9]+(\.gz)?)?$ f
# sysstat data (sa / sar files, rewritten every 10 min).
!/var/log/sysstat(/|$)
# Per-user journal (31_aide_systemd-journald): created at a user's first
# login, often after the baseline (system.journal stays watched).
!/var/log/journal/[^/]+/user-[0-9]+\.journal$ f
# zn-motd (login summary): replaced by "motd --update", not watched.
!/etc/profile\.d/zn-motd\.sh$
!/usr/local/bin/motd$
