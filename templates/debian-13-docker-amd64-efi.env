# Debian 13 (trixie) with Docker Engine (role docker, roles/docker/).
# File name must match: <OS>-<VER>[-<role>...]-<ARCH>-<FIRMWARE>

OS=debian
VER=13
ARCH=amd64
FIRMWARE=efi

# Roles layered on top of the base, space-separated, applied in order.
ROLES="docker"

# Platforms this template is built for.
PLATFORMS="vmware"

# Disks (defaults; DISK_GB, SWAP_GB, ESP_MIB from the environment or
# .env win). Disk 1: ESP + Btrfs, GiB in total (Docker data in
# /var/lib/docker on it). Disk 2: swap, GiB.
DISK_GB=50
SWAP_GB=2
ESP_MIB=512

# Virtual hardware written to the OVF.
CPUS=2
MEMORY_MB=4096
